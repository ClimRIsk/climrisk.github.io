# FastAPI serving layer — lightweight Python image (not conda)
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi uvicorn[standard] asyncpg httpx pydantic

COPY api/ /app/api/
COPY pipeline.py /app/pipeline.py

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
