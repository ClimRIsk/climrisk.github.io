# ── ClimRisk Backend — Environment Configuration ──────────────────────────────
# Copy to .env and fill in values. Never commit .env to git.

# ── PostgreSQL / PostGIS ──────────────────────────────────────────────────────
POSTGRES_USER=climrisk
POSTGRES_PASSWORD=change_me_strong_password

# ── TimescaleDB ───────────────────────────────────────────────────────────────
TIMESCALE_USER=climrisk
TIMESCALE_PASSWORD=change_me_ts_password

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=climrisk
MONGO_PASSWORD=change_me_mongo_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT   # SASL_SSL in production

# ── External data sources ────────────────────────────────────────────────────
OPEN_METEO_API_KEY=          # free tier OK for dev
NOAA_API_TOKEN=              # https://www.ncdc.noaa.gov/cdo-web/token
ERA5_API_KEY=                # Copernicus CDS
WRI_AQUEDUCT_API_KEY=        # https://www.wri.org/aqueduct

# ── Hazard layer storage ──────────────────────────────────────────────────────
# Path to directory containing GeoTIFF / NetCDF scenario files.
# Structure: /data/hazard_layers/{ssp}/{hazard_type}/{year}.tif
HAZARD_LAYERS_PATH=/data/hazard_layers

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
BATCH_CONCURRENCY=4
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
API_RATE_LIMIT=100/minute
